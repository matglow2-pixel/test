+"""Native Tk + real Spy/detector/storage; camera delivery uses a simulated backend."""
+from datetime import datetime
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import traceback
+import tkinter as tk
+from tkinter import ttk
+import cv2
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path[:0]=[str(ROOT),str(ROOT/'tests')]
+from test_spy_runner import SceneBackend
+from test_live_patrol import Clock,Locator
+from gem_detector import GemDetector
+import loong_lens,patrol_live_panel,spy_panel
+
+
+def main():
+    if sys.platform!='win32':raise SystemExit('Run this native UI check on Windows.')
+    temporary=tempfile.TemporaryDirectory(prefix='loonglens-spy-ui-')
+    original_local=os.environ.get('LOCALAPPDATA');os.environ['LOCALAPPDATA']=temporary.name
+    original=tk.Tk;panels={};errors=[];completed=[];state={}
+    original_sniper=patrol_live_panel.LivePatrolPanel.__init__
+    original_spy=spy_panel.SpyPanel.__init__
+    def sniper(panel,*a,**kw):original_sniper(panel,*a,**kw);panels['sniper']=panel
+    def spy(panel,*a,**kw):original_spy(panel,*a,**kw);panels['spy']=panel
+    patrol_live_panel.LivePatrolPanel.__init__=sniper;spy_panel.SpyPanel.__init__=spy
+
+    def descendants(widget):
+        return [item for child in widget.winfo_children() for item in (child,*descendants(child))]
+
+    class Window(original):
+        def __init__(self,*a,**kw):
+            super().__init__(*a,**kw)
+            def failed(kind,value,trace):errors.append(''.join(traceback.format_exception(kind,value,trace)));self.destroy()
+            self.report_callback_exception=failed
+            self.after(1800,self.begin);self.after(60000,self.destroy)
+        def begin(self):
+            sniper=panels['sniper'];spy=panels['spy'];services=sniper.services;services.sound.set(False)
+            notebook=next(w for w in descendants(self) if isinstance(w,ttk.Notebook))
+            assert [notebook.tab(t,'text') for t in notebook.tabs()]==['Map Tweaker','Gem Sniper','Gem Spy']
+            assert 'gem_watch_panel' not in sys.modules,'Removed tab is still being instantiated/imported'
+            old_mode=services.mode.get()
+            sniper.show_settings();self.update_idletasks()
+            settings=next(w for w in self.winfo_children() if isinstance(w,tk.Toplevel) and w.title()=='Gem Sniper settings')
+            next(w for w in descendants(settings) if isinstance(w,ttk.Combobox)).set('Sensitive')
+            next(w for w in descendants(settings) if isinstance(w,ttk.Button) and w.cget('text')=='Cancel').invoke()
+            assert services.mode.get()==old_mode,'Cancel changed shared detection preferences'
+            sniper.show_settings();self.update_idletasks()
+            settings=next(w for w in self.winfo_children() if isinstance(w,tk.Toplevel) and w.title()=='Gem Sniper settings')
+            next(w for w in descendants(settings) if isinstance(w,ttk.Combobox)).set('Sensitive')
+            next(w for w in descendants(settings) if isinstance(w,ttk.Button) and w.cget('text')=='Save settings').invoke()
+            assert services.mode.get()=='Sensitive'
