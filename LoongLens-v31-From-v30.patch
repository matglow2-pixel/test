+
+
+@pytest.fixture
+def view():return Viewpoint(100.,100.,'Test zone',frozenset({(100,100)}),12)
+
+
+@pytest.fixture
+def store(tmp_path):
+    result=SpyHistory(tmp_path/'sightings.sqlite3')
+    yield result
+    result.close()
+
+
+def at(hour,minute=0,second=0,day=18):return datetime(2026,10,day,hour,minute,second).timestamp()
+
+
+def gem(x=285.,y=514.5,score=.95,seen_at=None):
+    result=dict(screen_x=x,screen_y=y,score=score)
+    if seen_at is not None:result['seen_at']=result['last_seen']=seen_at
+    return result
+
+
+def test_distinct_encounter_adds_standard_row_with_correct_source_and_same_photo(store,view):
+    store.observe(view,1,at(8,31),clear=True)
+    fresh=store.observe(view,2,at(8,36),[gem()],clear=True)
+    event=fresh[0][0]
+    result=dict(event,capture_status='ready',screenshot_path='original.png',captured_at=at(8,36,1))
+    store.finish_capture(result)
+    row=store.standard.list()[0]
+    assert row.source=='Gem Spy' and row.source_label=='Gem Spy · Open screenshot'
+    assert row.seen_at==at(8,36) and row.score==.95 and row.screenshot_path=='original.png'
+    spy=store.encounters()[0]
+    assert spy['last_empty']==at(8,31) and spy['first_seen']==at(8,36) and spy['screenshot_path']==row.screenshot_path
+
+
+def test_repeated_gem_keeps_original_time_score_photo_and_hour(store,view):
+    event=store.observe(view,1,at(8,59),[gem()],True)[0][0]
+    store.finish_capture(dict(event,capture_status='ready',screenshot_path='once.png',captured_at=at(8,59)))
+    assert not store.observe(view,2,at(9,3),[gem(x=287,score=.99)],True)
+    assert not store.observe(view,3,at(10),[gem(x=283)],True)
+    assert store.totals()==dict(total=1,active=1)
+    row=store.encounters()[0]
+    assert row['runs']==3 and row['last_seen']==at(10) and row['score']==.95
+    standard=store.standard.list()
+    assert len(standard)==1 and standard[0].seen_at==at(8,59) and standard[0].screenshot_path=='once.png'
+    hours={datetime.fromtimestamp(r['hour_start']).hour:r['gems'] for r in store.hours()}
+    assert hours=={8:1,9:0,10:0}
+
+
+def test_two_gems_in_same_view_are_not_merged(store,view):
+    assert len(store.observe(view,1,at(8),[gem(220),gem(350)],True))==2
+    assert not store.observe(view,2,at(8,5),[gem(223),gem(347)],True)
