+@pytest.mark.parametrize('package', ['com.android.permissioncontroller', 'com.google.android.permissioncontroller'])
+def test_permission_dialog_does_not_become_the_game(monkeypatch, package):
+    device = Device(monkeypatch)
+    device.package = package
+    with pytest.raises(RuntimeError, match='Open the game'): device.connect()
+    assert not any('input' in cmd for cmd in device.commands)
