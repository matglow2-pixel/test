+def test_android_11_full_window_dump_and_activity_fallback(monkeypatch):
+    device = Device(monkeypatch)
+    backend = device.backend
+    commands = []
+    def command(*args):
+        commands.append(args)
+        if args == ('shell', 'dumpsys', 'window'):
+            return b'WINDOW MANAGER WINDOWS\nWindow #0 Window{abc u0 com.stale.app/.Old}\n'
+        assert args == ('shell', 'dumpsys', 'activity', 'activities')
+        return b'  topResumedActivity=ActivityRecord{abc u0 com.example.game/.Main t42}\n'
+    monkeypatch.setattr(backend, 'command', command)
+    assert backend.foreground_package() == 'com.example.game'
+    assert len(commands) == 2
+
+
+def test_unknown_focus_still_stops_without_touch_or_stale_fallback(monkeypatch):
+    device = Device(monkeypatch)
+    backend = device.backend
+    commands = []
+    def command(*args):
+        commands.append(args)
+        return b'mCurrentFocus=null\n'
+    monkeypatch.setattr(backend, 'command', command)
+    with pytest.raises(RuntimeError, match='cannot identify'): backend.foreground_package()
+    assert commands == [('shell', 'dumpsys', 'window')]
+
