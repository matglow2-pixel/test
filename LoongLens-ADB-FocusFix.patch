+    @staticmethod
+    def active_package(state, fields):
+        """Read only explicitly focused/resumed records, never the window list.
+
+        A present but null/unreadable record is a stop condition, not a reason
+        to select a potentially stale activity from elsewhere in the dump.
+        """
+        for field in fields:
+            records = re.findall(r'^\s*' + re.escape(field) + r'\s*[:=]\s*([^\r\n]*)', state, re.MULTILINE)
+            if not records:
+                continue
+            packages = []
+            for record in records:
+                match = re.search(r'\s([A-Za-z0-9_.]+)/[^\s}]+', record)
+                if not match:
+                    return True, None
+                packages.append(match.group(1))
+            return True, packages[0] if len(set(packages)) == 1 else None
+        return False, None
+
     def foreground_package(self):
-        state = self.command('shell', 'dumpsys', 'window', 'windows').decode('utf-8', errors='replace')
-        # Android 7/9/11 used by BlueStacks expose the foreground window here.
-        match = re.search(r'mCurrentFocus=Window\{[^\n}]*\s([A-Za-z0-9_.]+)/[^\s}]+', state)
-        if not match:
-            raise RuntimeError('ADB cannot identify the active Android app. Open the game, dismiss dialogs, and retry.')
-        return match.group(1)
+        # `dumpsys window windows` omits global focus on some Android 11 builds.
+        # The complete dump includes the current-focus summary on those builds.
+        state = self.command('shell', 'dumpsys', 'window').decode('utf-8', errors='replace')
+        present, package = self.active_package(state, ('mCurrentFocus', 'mFocusedWindow'))
+        if not present:
+            # Some emulator builds expose only the ActivityTaskManager record.
+            activity = self.command('shell', 'dumpsys', 'activity', 'activities').decode('utf-8', errors='replace')
+            _, package = self.active_package(activity, ('topResumedActivity', 'mResumedActivity'))
+        if not package:
+            raise RuntimeError('ADB cannot identify the active Android app. Check that this ADB port belongs to the BlueStacks instance running the game, dismiss Android dialogs, and retry.')
+        return package
 
     def focus(self):
         """Connect the selected instance without bringing its desktop window forward."""
