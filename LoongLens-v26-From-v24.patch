+def test_still_map_uses_one_recognition_but_two_observed_frames():
+    engine,backend,_=setup();frame=atlas_frame();captures=[];recognitions=[]
+    backend.capture=lambda:(captures.append(True) or frame.copy())
+    engine.title=SimpleNamespace(score=lambda f:1.)
+    pose=Match(12.45,-900.,279*12.45-1300,20,0,[])
