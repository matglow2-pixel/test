+"""Android-only screen and persistent touch input. Never calls desktop input."""
+from contextlib import contextmanager
+from dataclasses import dataclass,replace
+from pathlib import Path
+import hashlib
+import json
+import math
+import os
+import queue
+import re
+import shutil
+import subprocess
+import threading
+import time
+import cv2
+import numpy as np
+from patrol_windows import PatrolStopped
+from resources import ROOT
+
+
+class BackgroundInputError(RuntimeError):
+    pause_input=True
+
+
+@dataclass(frozen=True)
+class InputSettings:
+    mode:str='ADB'
+    adb_path:str=''
+    serial:str='127.0.0.1:5555'
+    content_rect:tuple=(0.,32.,570.,1013.)
+    package:str=''
+
+    def __post_init__(self):
+        if self.mode not in ('ADB','Mouse'):raise ValueError('Choose ADB or Mouse input.')
+        if not isinstance(self.adb_path,str):raise ValueError('ADB path must be text.')
+        match=re.fullmatch(r'127\.0\.0\.1:([0-9]{1,5})',self.serial)
+        if not match or not 1<=int(match[1])<=65535:raise ValueError('Use the BlueStacks loopback address, e.g. 127.0.0.1:5555.')
+        if len(self.content_rect)!=4 or not all(isinstance(v,(int,float)) and math.isfinite(v) for v in self.content_rect):raise ValueError('Invalid Android screen alignment.')
+        l,t,r,b=self.content_rect
+        if not(0<=l<r<=570 and 0<=t<b<=1029 and r-l>=400 and b-t>=750):raise ValueError('Android display must fill most of the reference picture.')
+        if not isinstance(self.package,str) or self.package and not re.fullmatch(r'[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)+',self.package):raise ValueError('Invalid Android app identifier.')
+        object.__setattr__(self,'content_rect',tuple(self.content_rect))
+
+
+def find_adb(configured=''):
+    if configured:
