+        else:
+            base=cv2.imread(str(root/'map.png'))
+            if state['open']:
+                image=cv2.warpAffine(base,np.float32([[1,0,state['dx']],[0,1,state['dy']]]),(570,1029))
+                for l,t,r,b in ((0,0,570,135),(410,40,570,240),(0,929,570,1029),(490,610,570,929)):image[t:b,l:r]=base[t:b,l:r]
+                if state.get('camera'):
+                    x,y=state['camera'];cv2.rectangle(image,(round(x-42),round(y-75)),(round(x+42),round(y+75)),(255,255,255),2)
+            else:image=cv2.imread(str(root/'game.png'))
+            image=cv2.resize(image[32:1013],(state['width'],state['height']))
+        ok,png=cv2.imencode('.png',image);sys.stdout.buffer.write(png.tobytes());return
+    raise SystemExit('Unsupported fixture command: '+repr(args))
+
+if __name__=='__main__':main()
