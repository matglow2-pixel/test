+"""Input setup, Android preview and an explicit background map-pan check."""
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import asdict,replace
+import threading
+import tkinter as tk
+from tkinter import ttk,messagebox,filedialog
+import cv2
+from PIL import Image,ImageTk
+from patrol_adb import InputSettings,align_android_display
+from patrol_live import LiveSettings
+from patrol_windows import WindowsBackend
+from resources import user_dir
+
+
+def probe_android(factory,settings,cancel,pan=False,reference_capture=None):
+    with factory(cancel,settings) as backend:
+        backend.connect();raw=backend.capture_raw();aligned=False
+        if not pan and reference_capture is not None:
+            try:
+                reference=reference_capture();rect=align_android_display(raw,reference)
+                settings=replace(settings,content_rect=rect);backend.settings=settings
+                l,t,r,b=rect;backend.drag_bounds=(l,t,r-1e-6,b-1e-6);aligned=True
+            except Exception:
+                if cancel.is_set():backend.check()
+        frame=backend.render(raw);info=backend.verify_game(frame);backend.last_frame=frame
+        if pan:
+            from vision import TitleDetector,Calibrator,track_map_pan
+            if TitleDetector().score(frame)<.64:raise RuntimeError('Open the large map before testing a map pan. No gameplay touch was sent.')
+            pose=Calibrator(user_dir()/'adb-alignment',wide=True).locate(frame)
+            if pose is None:raise RuntimeError('Use the default map zoom and show recognisable map terrain before the pan test.')
+            before=frame.copy();start=(285.,530.);end=(285.,490.)
+            with backend.hold_drag(start):backend.drag_held_to(end);backend.wait(.12)
+            backend.wait(.10);after=backend.capture()
+            if TitleDetector().score(after)<.64:raise RuntimeError('The map changed during the pan test. Stop and open the large map again.')
+            moved=track_map_pan(before,after,pose,(0.,-40.))
+            if moved is None or abs(moved.ty-pose.ty)<8:
+                raise RuntimeError('No map movement was confirmed. Move away from the map edge and retry. If BlueStacks is minimized, it may have paused rendering.')
+            dx,dy=moved.tx-pose.tx,moved.ty-pose.ty
+            restore=(start[0]-dx,start[1]-dy)
+            if abs(dx)>80 or abs(dy)>80:raise RuntimeError('Unexpected map movement; test stopped before another touch.')
+            with backend.hold_drag(start):backend.drag_held_to(restore);backend.wait(.12)
+            backend.wait(.10);restored=backend.capture()
+            returned=track_map_pan(after,restored,moved,(-dx,-dy))
+            if returned is None or abs(returned.tx-pose.tx)>5 or abs(returned.ty-pose.ty)>5:
+                raise RuntimeError('Touches reached Android, but the map did not return to its starting view. Inspect the map before starting.')
+            frame=restored;info['pan_verified']=True
+        info['auto_aligned']=aligned
+        return replace(settings,package=info.get('package','')),frame,info
+
+
+class InputDialog:
+    def __init__(self,panel):
+        self.panel=panel;self.root=panel.root;self.closed=False;self.future=None;self.job=None
+        self.cancel=threading.Event();self.pool=ThreadPoolExecutor(max_workers=1,thread_name_prefix='ADB-setup')
+        self.candidate=panel.input_settings;self.photo=None;self.frame=None
+        win=self.window=tk.Toplevel(self.root);win.title('Gem Sniper settings');win.transient(self.root)
+        win.protocol('WM_DELETE_WINDOW',self.close)
+        body=ttk.Frame(win,padding=18);body.pack(fill='both',expand=True)
+        self.mode=tk.StringVar(win,value=self.candidate.mode);self.path=tk.StringVar(win,value=self.candidate.adb_path)
+        self.serial=tk.StringVar(win,value=self.candidate.serial);self.note=tk.StringVar(win,value='ADB uses Android screenshots and touches. Your Windows mouse stays free.')
+        ttk.Label(body,text='Input and map controls',style='Heading.TLabel').grid(row=0,column=0,columnspan=3,sticky='w',pady=(0,10))
+        ttk.Label(body,text='Input mode').grid(row=1,column=0,sticky='w')
