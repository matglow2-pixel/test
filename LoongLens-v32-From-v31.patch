+        if backend.open and point!=LiveSettings().map_close:backend.inputs.append(('click',point,True))
+        else:original(point)
+    backend.click=ignore
+    with pytest.raises(RuntimeError,match='Camera selection not confirmed'):engine.run(backend,auto=False)
+    assert not engine.checked and backend.open
