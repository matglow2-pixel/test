+def camera_selection_visible(frame,point,scale):
+    """Require the camera's white rectangular outline, not a tap ripple.
+
+    Test the expected outline at the clicked map coordinate. Clipped edges and
+    the four marked map controls contribute no evidence. A small round click
+    animation cannot supply two long perpendicular rectangle edges.
+    """
+    import numpy as np
+    from patrol_route import MAP_BLOCKED_RECTS,MAP_CONTENT_BOUNDS
+    normal=LivePatrol.normal(frame);hsv=cv2.cvtColor(normal,cv2.COLOR_BGR2HSV)
+    white=cv2.inRange(hsv,np.array((0,0,205)),np.array((179,75,255)))!=0
+    gray=cv2.cvtColor(normal,cv2.COLOR_BGR2GRAY)
+    thin=cv2.morphologyEx(gray,cv2.MORPH_TOPHAT,np.ones((9,9),np.uint8))>=8
+    white &= thin  # Pale terrain/blank frames are not a white camera outline.
+    x,y=point;half_w=scale*6.7/2;half_h=scale*12.1/2
+    allowed=np.zeros_like(white)
+    a,b,c,d=MAP_CONTENT_BOUNDS;allowed[b:d+1,a:c+1]=True
+    for a,b,c,d in MAP_BLOCKED_RECTS:allowed[b:d+1,a:c+1]=False
+    def edge(x1,y1,x2,y2):
+        count=max(1,round(math.dist((x1,y1),(x2,y2))))
+        px=np.rint(np.linspace(x1,x2,count)).astype(int);py=np.rint(np.linspace(y1,y2,count)).astype(int)
+        inside=(px>=3)&(px<567)&(py>=3)&(py<1026)
+        px=px[inside];py=py[inside]
+        keep=allowed[py,px];px=px[keep];py=py[keep]
+        if len(px)<8:return False
+        matches=np.zeros(len(px),bool)
+        for dx in range(-3,4):
+            for dy in range(-3,4):matches |= white[py+dy,px+dx]
+        return float(matches.mean())>=.72
+    left=edge(x-half_w,y-half_h,x-half_w,y+half_h)
+    right=edge(x+half_w,y-half_h,x+half_w,y+half_h)
+    top=edge(x-half_w,y-half_h,x+half_w,y-half_h)
+    bottom=edge(x-half_w,y+half_h,x+half_w,y+half_h)
+    return sum((left,right,top,bottom))>=2
+
