+    assert state['events']==[]
+
+
+def test_cursor_redirected_by_windows_is_not_clicked():
+    value,state=backend()
+    value.api.user.SetCursorPos=lambda *p:True  # Windows/another clip redirected it.
+    with pytest.raises(RuntimeError,match='did not reach'):value.click((200,400))
+    assert not any(event[0]=='button' for event in state['events'])
+
+
+def test_normal_click_is_delivered_inside_client_and_restores_previous_clip():
+    value,state=backend();original=state['clip']
+    value.click((200,400))
+    assert state['events']==[('move',(300,500)),('button',2),('button',4)]
+    assert state['clip']==original and not value.down
+
+
+def test_f10_during_hold_releases_button_and_original_cursor_clip():
+    value,state=backend();original=state['clip']
+    with pytest.raises(PatrolStopped):
+        with value.hold_drag((285,530)):
+            assert state['clip']==value.input_rect
+            value.cancel.set();value.release();value.drag_held_to((300,500))
+    assert state['clip']==original and not value.down
+    assert [row for row in state['events'] if row[0]=='button']==[('button',2),('button',4)]
+
+
+def test_pointer_boundary_uses_real_native_border_width_not_added_padding():
+    native=NativeInput.__new__(NativeInput)
+    def client(hwnd,p):p._obj.right=400;p._obj.bottom=700;return True
+    def origin(hwnd,p):p._obj.x=100;p._obj.y=50;return True
+    native.user=SimpleNamespace(GetClientRect=client,ClientToScreen=origin)
+    native.client_hit=lambda hwnd,p:107<=p[0]<493 and 81<=p[1]<744
+    assert native.input_rect(123)==(107,81,493,744)
+
+
+def test_full_window_reference_rounding_never_maps_to_pixel_outside_window():
+    value,_=backend()
+    assert value.point((569.99,1028.99))==(669,1128)
+
+
+def test_route_reveals_a_target_on_the_native_border_instead_of_clicking_it():
+    value,_=backend()
+    assert not LivePatrol.target_visible(value,(5,500))
+    assert LivePatrol.target_visible(value,(8,500))
+    cursor=(285,530)
+    for _ in range(4):
+        end=route_drag_step(cursor,(1,0),bounds=value.drag_bounds)
+        if end is None:break
+        cursor=end
+    assert cursor[0]<=561 and cursor[0]>560
