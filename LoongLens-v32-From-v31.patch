+
+
+def backend():
+    value=WindowsBackend.__new__(WindowsBackend)
+    value.cancel=threading.Event();value.down=False;value.target=(123,(100,100,570,1029))
+    value.input_rect=(108,130,662,1121);value.drag_bounds=(8,30,561,1020)
+    value._clip_saved=None;value._clip_owned=None
+    state=dict(cursor=(300,400),clip=(-1920,0,3840,2160),events=[])
+    def move(x,y):state['cursor']=(x,y);state['events'].append(('move',(x,y)));return True
+    value.api=SimpleNamespace(user=SimpleNamespace(SetCursorPos=move),cursor=lambda:state['cursor'],
+        client_hit=lambda hwnd,p:108<=p[0]<662 and 130<=p[1]<1121,
+        mouse=lambda flag:state['events'].append(('button',flag)),left_down=lambda:True,
+        clip_rect=lambda:state['clip'],clip=lambda rect:state.update(clip=rect))
+    value.guard=lambda:(_ for _ in ()).throw(PatrolStopped('Stopped')) if value.cancel.is_set() else None
+    value.visible_at=lambda *a:True;value.wait=lambda t:value.guard()
+    return value,state
+
+
+@pytest.mark.parametrize('point',[(4,500),(565,500),(285,1028),(285,20)])
+def test_border_target_never_moves_or_presses_mouse_and_restores_clip(point):
+    value,state=backend();original=state['clip']
+    with pytest.raises(RuntimeError,match='border'):value.click(point)
+    assert not state['events'] and state['clip']==original and not value.down
+
+
+def test_hit_test_rejects_a_resize_handle_even_inside_the_client_rectangle():
+    value,state=backend();value.api.client_hit=lambda *a:False
