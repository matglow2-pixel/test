+    if not 1<=len(paths)<=6:raise ValueError('Choose one whole map or up to six original map screenshots.')
+    reference_path=Path(reference_path or ROOT/'loong_haven_default_atlas.png')
+    with Image.open(reference_path) as image:reference=np.asarray(image.convert('RGB'))
+    if reference.shape[:2]!=(3486,3486):raise ValueError('Unexpected bundled map dimensions.')
+    features=map_features(reference);images=[];matrices=[];pixels=0
