+def map_features(rgb):
+    h,w=rgb.shape[:2];factor=min(1.,1600/max(h,w))
+    small=cv2.resize(rgb,None,fx=factor,fy=factor,interpolation=cv2.INTER_AREA) if factor<1 else rgb
+    gray=cv2.cvtColor(small,cv2.COLOR_RGB2GRAY)
+    mask=(small.max(axis=2)>40).astype(np.uint8)*255
+    points,descriptors=cv2.SIFT_create(nfeatures=10000,contrastThreshold=.015).detectAndCompute(gray,mask)
+    xy=np.array([p.pt for p in points],np.float32).reshape(-1,2)/factor
+    return xy,descriptors
+
+
+def align_map(rgb,reference_features):
+    points,descriptors=map_features(rgb);dest,reference=reference_features
+    if descriptors is None or reference is None:raise ValueError('Not enough map detail to align this image.')
+    pairs=cv2.BFMatcher().knnMatch(descriptors,reference,k=2)
+    good=[a for pair in pairs if len(pair)==2 for a,b in [pair] if a.distance<.72*b.distance]
+    if len(good)<20:raise ValueError('Could not recognise this map image. Use original Loong Haven map screenshots.')
+    source=np.float32([points[m.queryIdx] for m in good]);target=np.float32([dest[m.trainIdx] for m in good])
+    affine,inliers=cv2.estimateAffinePartial2D(source,target,method=cv2.RANSAC,ransacReprojThreshold=5.,maxIters=5000,confidence=.999)
+    if affine is None or inliers is None or int(inliers.sum())<20:raise ValueError('Map alignment is uncertain; the current map was kept.')
+    if abs(math.degrees(math.atan2(affine[1,0],affine[0,0])))>.5:raise ValueError('Use upright map screenshots without perspective or rotation.')
+    keep=inliers[:,0].astype(bool);source=source[keep];target=target[keep]
+    if np.ptp(source,axis=0).min()<min(rgb.shape[:2])*.15:raise ValueError('Recognised area is too small to safely place this map.')
+    # Fit axis-aligned scale/translation only. This keeps the map north-up and
+    # avoids introducing rotation/shear or silently moving history locations.
+    a=source-source.mean(axis=0);b=target-target.mean(axis=0)
+    scale=float((a*b).sum()/(a*a).sum());offset=np.median(target-source*scale,axis=0)
+    error=np.linalg.norm(source*scale+offset-target,axis=1)
+    if not .2<=scale<=8 or float(np.median(error))>4 or np.percentile(error,90)>9:
+        raise ValueError('Map alignment is not accurate enough; the current map was kept.')
+    return np.float32([[scale,0,offset[0]],[0,scale,offset[1]]])
+
+
+def stitch_maps(paths,reference_path=None,cancel=None):
+    def check():
+        if cancel is not None and cancel.is_set():raise RuntimeError('Map import cancelled.')
