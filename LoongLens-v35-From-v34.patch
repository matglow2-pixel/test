+    assert len(quota.entries(today_only=False))==2
+    assert quota.count(at(21,16))==0
+
+
+def test_unknown_entry_cannot_create_an_obtained_count(tmp_path):
+    quota=SniperQuota(tmp_path/'sightings.sqlite3')
+    with pytest.raises(ValueError):quota.set_obtained('not-a-find',True)
+    assert not quota.entries(today_only=False)
