+        elif key and column=='#4':self.tree.selection_set(key);self.open_screenshot()
+
+    def open_screenshot(self):
+        row=self.selected()
+        if not row:return
+        if not row['screenshot_path']:
+            messagebox.showinfo('Gem screenshot','No screenshot is available for this entry.',parent=self.window);return
+        path=Path(row['screenshot_path']).resolve();folder=(self.quota.path.parent/'screenshots').resolve()
