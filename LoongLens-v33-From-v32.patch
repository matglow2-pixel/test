+"""Native Windows UI + real detector/storage; game delivery and waits are simulated."""
+from dataclasses import replace
+import json
+import logging
+import os
+from pathlib import Path
+import sys
+import tempfile
+import time
+import traceback
+import tkinter as tk
+import cv2
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path[:0]=[str(ROOT),str(ROOT/'tests')]
+import loong_lens,patrol_live_panel
+from gem_detector import GemDetector
+from test_spy_runner import SceneBackend
+from test_live_patrol import Clock,Locator
+from types import SimpleNamespace
+
+
+def main():
+    if sys.platform!='win32':raise SystemExit('Run this native UI check on Windows.')
+    temporary=tempfile.TemporaryDirectory(prefix='loonglens-sniper-ui-')
+    previous_local=os.environ.get('LOCALAPPDATA');os.environ['LOCALAPPDATA']=temporary.name
+    original_tk=tk.Tk;original_init=patrol_live_panel.LivePatrolPanel.__init__
+    panels={};errors=[];results=[];state={}
+    def remember(panel,*a,**kw):original_init(panel,*a,**kw);panels['sniper']=panel
+    patrol_live_panel.LivePatrolPanel.__init__=remember
+
+    class Window(original_tk):
+        def exit_app(self):
+            from tkinter import ttk
+            def descendants(widget):
+                return [item for child in widget.winfo_children() for item in (child,*descendants(child))]
+            button=next((w for w in descendants(self) if isinstance(w,ttk.Button) and w.cget('text')=='Exit'),None)
+            if button is None:self.destroy()
+            else:button.invoke()
+        def __init__(self,*a,**kw):
+            super().__init__(*a,**kw)
+            def failed(kind,value,trace):errors.append(''.join(traceback.format_exception(kind,value,trace)));self.exit_app()
+            self.report_callback_exception=failed
+            self.after(1800,self.begin);self.after(60000,self.exit_app)
+        def begin(self):
+            panel=panels['sniper'];panel.services.sound.set(False)
+            now=time.time()
+            for i in range(4):panel.services.sighting_history.mark_sniper_seen(f'patrol:earlier-{i}',now-60)
+            views=(replace(panel.base_views[0],x=241.,y=107.),)
+            panel.apply_route(views)
+            clock=Clock();backend=SceneBackend(views,clock)
+            backend.cancel=panel.runner.cancel
+            image=cv2.imread(str(ROOT/'gem_templates/gem_0.png'));h,w=image.shape[:2]
+            backend.frame[400:400+h,240:240+w]=image
+            runner=panel.runner;runner.backend_factory=lambda cancel:backend
+            runner.stats.clock=clock;runner.pass_stats.clock=clock;runner.wall=lambda:now+clock.now
+            runner.detector=GemDetector();runner.locator=Locator(backend)
+            runner.title=SimpleNamespace(score=lambda f:float(f[0,0,0]))
+            recorded=[];emit=runner.emit
+            def report(event):recorded.append(event);emit(event)
+            runner.emit=report
+            clicks=[];click=backend.click
+            def record(point):clicks.append((point,clock.now,backend.open));click(point)
+            backend.click=record
+            state.update(clock=clock,backend=backend,events=recorded,clicks=clicks)
+            panel.snipe.invoke()
+            assert panel.services.owner=='sniper'
+            self.after(100,self.done)
+        def done(self):
+            panel=panels['sniper'];runner=panel.runner
+            if runner.running:self.after(100,self.done);return
+            panel.drain()
+            if panel.futures:self.after(100,self.done);return
+            panel.services.flush_sightings();panel.seen_refresh=0
+            panel.seen_text.set(f'{panel.services.sighting_history.sniper_seen()}/5')
+            events=state['events'];clicks=state['clicks'];backend=state['backend']
+            assert panel.services.owner is None and panel.seen_text.get()=='5/5'
+            assert '5/5' in panel.status.get() and 'Returned' in panel.status.get(),panel.status.get()
+            assert sum(e['kind']=='gem_clicked' for e in events)==1
+            assert sum(e['kind']=='returned_home' for e in events)==1
