+def test_f10_interrupts_pending_adb_command_and_reaps_process(monkeypatch):
+    cancel = threading.Event()
+    calls = []
+    class Pending:
+        returncode = None
+        def __init__(self, *args, **kwargs): pass
+        def communicate(self, timeout=None):
+            calls.append(timeout)
+            if timeout is not None:
+                cancel.set()
+                raise subprocess.TimeoutExpired('adb', timeout)
+            return b'', b''
+        def poll(self): return self.returncode
+        def kill(self): calls.append('kill'); self.returncode = -9
+    monkeypatch.setattr(patrol_adb.subprocess, 'Popen', Pending)
+    backend = AdbBackend(cancel)
+    backend.executable = 'adb'
+    with pytest.raises(PatrolStopped): backend.command('get-state')
+    assert calls == [.05, 'kill', None]
