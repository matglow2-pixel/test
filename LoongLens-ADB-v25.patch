+def png(width=570, height=1029, color=(17, 93, 201)):
+    frame = np.full((height, width, 3), color, np.uint8)
+    return cv2.imencode('.png', frame)[1].tobytes()
+
+
+class Device:
+    def __init__(self, monkeypatch, settings=None):
+        self.commands = []
+        self.image = png()
+        self.package = 'com.example.game'
+        self.output = None
+        self.error = b''
+        self.code = 0
+        self.on_input = None
+        self.cancel = threading.Event()
+        device = self
+        monkeypatch.setattr(patrol_adb, 'find_adb', lambda path: 'chosen-adb.exe')
+
+        class Process:
+            def __init__(self, command, **kwargs):
+                assert 'shell' not in kwargs
+                device.commands.append(command)
+                self.returncode = None
+                if command[-1] == 'get-state':
+                    self.output = b'device\n'
+                elif command[-2:] == ['screencap', '-p']:
+                    self.output = device.image() if callable(device.image) else device.image
+                elif command[-2:] == ['window', 'windows']:
+                    self.output = f'mCurrentFocus=Window{{abc u0 {device.package}/.MainActivity}}'.encode()
+                else:
+                    self.output = b'connected'
+                    if 'touchscreen' in command and device.on_input is not None:
+                        device.on_input(command[command.index('touchscreen')+1:])
+
+            def communicate(self, timeout=None):
+                self.returncode = device.code
+                return device.output if device.output is not None else self.output, device.error
+
+            def poll(self): return self.returncode
+            def kill(self): self.returncode = -9
+
+        monkeypatch.setattr(patrol_adb.subprocess, 'Popen', Process)
+        self.backend = AdbBackend(self.cancel, settings or InputSettings(mode='ADB'))
+        self.backend.__enter__()
+
+    def connect(self):
+        self.backend.focus()
+        return self.backend
+
