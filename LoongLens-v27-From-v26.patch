+"""Held map movement, early stopping, input cleanup and the user's map boundary."""
+from contextlib import contextmanager
+from dataclasses import replace
+from types import SimpleNamespace
+import math
+import threading
+import pytest
+from camera_patrol import Viewpoint
+from patrol_live import LivePatrol,LiveSettings,MapAlignmentLost
+from patrol_windows import WindowsBackend,PatrolStopped
+from patrol_route import (route_point_visible,route_reveal_delta,route_drag_start,
+                          route_drag_step,DRAG_BOUNDS)
+from test_live_patrol import setup
+
+
+@pytest.mark.parametrize('delta,start',[
+    ((0,-100),(285,900)),((0,100),(285,270)),
+    ((-100,0),(490,500)),((100,0),(38,500)),
+    ((-100,-100),(490,900)),((100,100),(38,270)),
+    ((100,-100),(38,900)),((-100,100),(490,270))])
+def test_directional_anchor_leaves_room_and_avoids_controls(delta,start):
+    assert route_drag_start(delta)==start
+    assert route_point_visible(start)
+    end=route_drag_step(start,delta)
+    assert route_point_visible(end)
+    assert math.dist(start,end)<=120.001
+
+
+@pytest.mark.parametrize('point',[(650,500),(-100,500),(450,180),(280,1060),(280,-100)])
+def test_reveal_moves_into_user_outline_without_centering(point):
+    dx,dy=route_reveal_delta(point)
+    target=(point[0]+dx,point[1]+dy)
+    assert route_point_visible(target)
+    assert math.hypot(dx,dy)<math.dist(point,(285,500))
+
+
+@pytest.mark.parametrize('point',[(480,180),(530,800),(64,980),(285,960),(5,500)])
+def test_controls_and_edges_are_not_revealed_targets(point):
+    assert not route_point_visible(point)
+
+
+def native_backend():
+    backend=WindowsBackend.__new__(WindowsBackend)
+    backend.down=False;backend.cancel=threading.Event();actions=[]
+    backend.api=SimpleNamespace(mouse=lambda flag:actions.append(('button',flag)))
+    backend.move=lambda point:actions.append(('move',point))
+    backend.guard=lambda:None
+    backend.wait=lambda seconds:actions.append(('wait',seconds))
+    return backend,actions
+
+
+def test_one_press_across_multiple_moves_and_stationary_release():
+    backend,actions=native_backend()
+    with backend.hold_drag((285,900)):
+        backend.drag_held_to((285,780))
+        backend.drag_held_to((285,660))
+        assert [a for a in actions if a[0]=='button']==[('button',2)]
+    assert [a for a in actions if a[0]=='button']==[('button',2),('button',4)]
+    assert actions[-2:]==[('wait',.18),('button',4)]
+    assert not backend.down
+
+
+@pytest.mark.parametrize('failure',['cancel','covered','focus','resize'])
