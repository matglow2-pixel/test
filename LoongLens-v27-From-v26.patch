+def route_point_visible(point):
+    """Require a small inset so a revealed target is clear of map controls."""
+    x,y=point
+    return all(map_clickable((x+dx,y+dy)) for dx,dy in
+               ((0,0),(-8,-8),(-8,8),(8,-8),(8,8)))
+
+
+def route_reveal_delta(point):
+    """Move toward the nearest clear map area, rather than toward its centre."""
+    x,y=point
+    rectangles=((24.,112.,400.,910.),(24.,264.,488.,900.),(24.,264.,526.,596.))
+    targets=[(min(right,max(left,x)),min(bottom,max(top,y)))
+             for left,top,right,bottom in rectangles]
+    tx,ty=min(targets,key=lambda p:math.dist(point,p))
+    return tx-x,ty-y
+
+
+DRAG_BOUNDS=(38.,270.,490.,900.)
+
+
+def route_drag_start(delta):
+    """Start opposite the desired map motion, leaving a full clear stroke."""
+    dx,dy=delta;left,top,right,bottom=DRAG_BOUNDS
+    return (left if dx>1 else right if dx < -1 else 285.,
+            top if dy>1 else bottom if dy < -1 else 500.)
+
+
+def route_drag_step(cursor,delta,limit=120.):
+    """Bound a held movement by its next screenshot check and clear surface."""
+    dx,dy=delta;length=math.hypot(dx,dy)
+    if length<.5:return None
+    left,top,right,bottom=DRAG_BOUNDS
+    factor=min(1.,limit/length)
+    for value,change,low,high in ((cursor[0],dx,left,right),(cursor[1],dy,top,bottom)):
+        if change>0:factor=min(factor,(high-value)/change)
+        elif change<0:factor=min(factor,(low-value)/change)
+    if factor<=0 or length*factor<.5:return None
+    return (min(right,max(left,cursor[0]+dx*factor)),
+            min(bottom,max(top,cursor[1]+dy*factor)))
 
 
