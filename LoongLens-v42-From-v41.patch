+    started=threading.Event();moved=threading.Event();original=engine.detector
+    drag=backend.drag_held_to
+    def moving(end):
+        drag(end);moved.set()
+        # Give the real worker its deterministic completion point during hold.
+        assert finished.wait(3)
+    finished=threading.Event();backend.drag_held_to=moving
+    def detect(frame,**kw):
+        if threading.current_thread().name=='LoongLens-screenshot':
+            started.set();assert moved.wait(3)
+            result=original.detect(frame,**kw);finished.set();return result
