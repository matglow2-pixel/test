+"""Deterministic delayed workers prove ownership, map return and Stop ordering."""
+from dataclasses import replace
+from types import SimpleNamespace
+import math
+import threading
+import time
+import cv2
+import numpy as np
+import pytest
+
+from camera_patrol import Spawn
+from gem_detector import GemDetector
+from gem_scene_fixture import GemCameraScene
+from patrol_live import LiveSettings
+from patrol_windows import PatrolStopped
+from snapshot_sweep import SnapshotQueue,SnapshotCandidate,capture_snapshot
+from test_live_patrol import setup
+
+cv2.setNumThreads(2)
+
+
+def textured_engine(center=(285,515),gem=True,spawns=None):
+    engine,backend,events=setup(spawns=spawns)
+    engine.settings=LiveSettings(quick_sweep=True)
+    scene=GemCameraScene(center);scene.collected=not gem
+    original_capture=backend.capture;original_click=backend.click;original_drag=backend.drag
+    scene_view=(engine.views[0].x,engine.views[0].y)
+    def capture():
+        if backend.open:return original_capture()
+        frame=scene.render()
+        if backend.selected_world is None or math.dist(backend.selected_world,scene_view)>.1:
+            saved=scene.collected;scene.collected=True;frame=scene.render();scene.collected=saved
+        return frame
+    def click(point):
+        if not backend.open and point!=engine.settings.map_open:scene.click(point)
+        return original_click(point)
+    def drag(start,end):
+        if backend.open:return original_drag(start,end)
+        scene.pan(start,end);backend.wait(.3)
+    backend.capture=capture;backend.click=click;backend.drag=drag
+    backend.releases=0
+    def release():backend.releases+=1;backend.held=False
+    backend.release=release;engine.detector=GemDetector()
+    return engine,backend,events,scene
+
+
+def test_empty_views_have_one_worker_screenshot_each_and_no_long_inspection():
+    engine,backend,events,scene=textured_engine(gem=False)
+    inspect=engine.inspect
+    engine.inspect=lambda *a,**kw:pytest.fail('A ready empty view must not use the 1.2s inspection')
+    calls=[];detector=engine.detector
+    def detect(frame,**kw):calls.append((threading.current_thread().name,frame.flags.writeable));return detector.detect(frame,**kw)
+    engine.detector=SimpleNamespace(detect=detect)
+    assert 'Pass complete' in engine.run(backend)
+    assert engine.checked=={0,1} and len(calls)==2
+    assert all(name=='LoongLens-screenshot' and not writeable for name,writeable in calls)
+    assert not any(e['kind'] in ('found','capture','gem_clicked') for e in events)
+    assert len([row for row in backend.inputs if row[0]=='click'])==5
+    assert engine.snapshot_queue is None
+
+
+def test_positive_screenshot_returns_to_original_view_and_keeps_its_photo_time_and_count():
+    engine,backend,events,scene=textured_engine()
+    original=engine.detector;ready=threading.Event();map_open=threading.Event()
+    capture=backend.capture
+    def screen():
+        if backend.open and ready.is_set():map_open.set()
+        return capture()
+    backend.capture=screen
+    def detect(frame,**kw):
+        if threading.current_thread().name=='LoongLens-screenshot':
+            ready.set();assert map_open.wait(3),'Navigation did not overlap screenshot analysis'
+        return original.detect(frame,**kw)
+    engine.detector=SimpleNamespace(detect=detect)
+    assert 'Clicked the gem once' in engine.run(backend)
+    assert scene.collected and len(scene.clicks)==1 and not scene.hud_clicks
+    assert backend.releases==1
+    assert all(sum(e['kind']==kind for e in events)==1 for kind in ('snapshot_return','found','capture','gem_clicked'))
