+def test_recenter_collection_keeps_one_daily_entry_and_twenty_second_return_wait(tmp_path):
+    from test_sniper_collection_cycle import collecting_runner
+    runner,backend,events,quota,times,_=collecting_runner(tmp_path,stop_at=lambda e:e['kind']=='returned_home')
+    scene=GemCameraScene();capture=backend.capture;drag=backend.drag;click=backend.click
+    backend.capture=lambda:capture() if backend.open else scene.render()
+    def pan(start,end):
+        if backend.open:return drag(start,end)
+        backend.wait(.3);scene.pan(start,end);backend.inputs.append(('ground_drag',start,end))
