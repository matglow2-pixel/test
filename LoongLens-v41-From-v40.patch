+    def draw_gem(self,frame,center):
+        h,w=self.template.shape[:2];x=round(center[0]-w/2);y=round(center[1]-h/2)
+        if 0<=x and 0<=y and x+w<=frame.shape[1] and y+h<=frame.shape[0]:
+            frame[y:y+h,x:x+w]=self.template
+
+    def pan(self,start,end):
