+        if not backend.open and point!=LiveSettings().map_open:scene.click(point)
+        return click(point)
+    backend.drag=pan;backend.click=target;runner.detector=GemDetector()
+    assert runner.start(LiveSettings(mask_hud=False),repeat=True)
+    runner.thread.join(15)
+    if runner.running:runner.stop();runner.thread.join(3)
+    assert not runner.running and quota.count(runner.wall())==1 and runner.stats.snapshot()['gems']==1
+    assert not scene.hud_clicks and all(sum(e['kind']==kind for e in events)==1 for kind in ('found','capture','gem_clicked','gem_recentered'))
+    stamp=next(t for point,t,opened in times if not opened and point!=LiveSettings().map_open)
+    opener=next(t for point,t,opened in times if point==LiveSettings().map_open and t>stamp)
+    assert opener-stamp>=20
