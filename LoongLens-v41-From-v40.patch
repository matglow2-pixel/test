+
+class GemCameraScene:
+    def __init__(self,center=(520,680),gain=1.,freeze=False):
+        rng=np.random.default_rng(731)
+        gray=rng.integers(0,145,(1500,850),np.uint8)
+        gray=cv2.resize(gray,(1700,3000),interpolation=cv2.INTER_CUBIC)
+        self.world=np.stack((gray//3+55,gray//3+90,gray//3+110),axis=2).astype(np.uint8)
+        for _ in range(100):
+            x=int(rng.integers(20,1680));y=int(rng.integers(20,2980))
+            cv2.circle(self.world,(x,y),int(rng.integers(8,30)),(65,95,110),2)
+        self.template=cv2.imread(str(ROOT/'gem_templates/gem_0.png'))
+        self.center=np.asarray(center,dtype=float);self.offset=np.zeros(2)
+        self.gain=gain;self.freeze=freeze;self.collected=False
+        self.hide_after_pan=False;self.extra_after_pan=False
+        self.drags=[];self.clicks=[];self.hud_clicks=[]
+
+    @property
+    def gem_center(self):return tuple(self.center+self.offset)
+
+    def render(self):
+        dx,dy=self.offset
+        frame=cv2.warpAffine(self.world,np.float32([[1,0,dx-560],[0,1,dy-990]]),(570,1029))
+        if not self.collected and not (self.hide_after_pan and np.linalg.norm(self.offset)>1):
+            self.draw_gem(frame,self.gem_center)
+            if self.extra_after_pan and np.linalg.norm(self.offset)>1:
+                self.draw_gem(frame,(self.gem_center[0]+20,self.gem_center[1]))
+        # Static HUD is deliberately unrelated to camera motion. The icon's
+        # larger logical hit rectangle extends below the visible circle,
+        # matching the reported gem-near-portrait case.
+        cv2.rectangle(frame,(3,34),(240,170),(55,65,75),-1)
+        cv2.circle(frame,(515,135),70,(80,130,80),-1)
+        cv2.circle(frame,(520,625),28,(210,220,220),3)
